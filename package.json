{
  "name": "drift-dashboard",
  "productName": "Drift Dashboard",
  "version": "2.1.2",
  "description": "Everything at a glance: Spotify, Plex, Claude plan usage, your next gig (Drift: Record), email, calendars, Slack, ClickUp, Strava, Xbox and support tickets.",
  "author": "Drift Creative Systems",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "icons": "node scripts/make-icons.js",
    "logos": "node scripts/make-logos.js",
    "check": "node scripts/check.js",
    "dist": "electron-builder --win --publish never",
    "mac": "node scripts/mac-app.js",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "uk.co.bonsaidigitalcollective.dashboard",
    "productName": "Drift Dashboard",
    "copyright": "Copyright © 2026 Drift Creative Systems Ltd",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "README.md",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "identity": null,
      "extendInfo": {
        "LSMultipleInstancesProhibited": true
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "drift-creative-systems",
        "repo": "bonsai-dashboard-releases",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "imapflow": "2.4.0",
    "node-ical": "0.27.3"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "simple-icons": "16.35.0"
  }
}
